#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#include "common.glsl"
// mode 0: LayerNorm  (x - mean) / sqrt(var + eps) * w + b   (biased variance)
// mode 1: RMSNorm    x / sqrt(mean(x^2) + eps) * w
// One subgroup per contiguous row of `len` elements.
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) readonly buffer W { float w[]; };
layout(binding = 2) readonly buffer B { float b[]; };
layout(binding = 3) writeonly buffer Y { float y[]; };
layout(push_constant) uniform PC {
  uint rows; uint len; uint rows_per_wg; uint mode; uint has_w; uint has_b; float eps;
} pc;
void main() {
  uint wg = um_linear_group();
  uint lane = gl_SubgroupInvocationID, step = gl_SubgroupSize;
  float flen = float(pc.len);
  for (uint r = gl_SubgroupID; r < pc.rows_per_wg; r += gl_NumSubgroups) {
    uint row = wg * pc.rows_per_wg + r;
    if (row >= pc.rows) break;
    uint base = row * pc.len;
    if (pc.mode == 0u) {
      float s = 0.0;
      for (uint j = lane; j < pc.len; j += step) s += x[base + j];
      float mean = subgroupAdd(s) / flen;
      float v = 0.0;
      for (uint j = lane; j < pc.len; j += step) {
        float d = x[base + j] - mean;
        v += d * d;
      }
      float var = subgroupAdd(v) / flen;
      float inv = 1.0 / sqrt(var + pc.eps);
      for (uint j = lane; j < pc.len; j += step) {
        float t = (x[base + j] - mean) * inv;
        if (pc.has_w != 0u) t = t * w[j];
        if (pc.has_b != 0u) t = t + b[j];
        y[base + j] = t;
      }
    } else {
      float s = 0.0;
      for (uint j = lane; j < pc.len; j += step) {
        float v = x[base + j];
        s += v * v;
      }
      float ms = subgroupAdd(s) / flen;
      float inv = 1.0 / sqrt(ms + pc.eps);
      for (uint j = lane; j < pc.len; j += step) {
        float t = x[base + j] * inv;
        if (pc.has_w != 0u) t = t * w[j];
        y[base + j] = t;
      }
    }
  }
}
