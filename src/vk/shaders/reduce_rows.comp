#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#include "common.glsl"
// Reduce contiguous rows (reduced axis is the innermost). op: 0 sum 1 mean 2 max 3 min.
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) writeonly buffer Y { float y[]; };
layout(push_constant) uniform PC { uint rows; uint len; uint rows_per_wg; uint op; } pc;
void main() {
  uint wg = um_linear_group();
  uint lane = gl_SubgroupInvocationID, step = gl_SubgroupSize;
  for (uint r = gl_SubgroupID; r < pc.rows_per_wg; r += gl_NumSubgroups) {
    uint row = wg * pc.rows_per_wg + r;
    if (row >= pc.rows) break;
    uint base = row * pc.len;
    float res;
    if (pc.op <= 1u) {
      precise float s = 0.0, comp = 0.0;
      for (uint j = lane; j < pc.len; j += step) {
        precise float y = x[base + j] - comp;
        precise float t = s + y;
        comp = (t - s) - y;
        s = t;
      }
      res = subgroupAdd(s);
      if (pc.op == 1u) res /= float(pc.len);
    } else if (pc.op == 2u) {
      float m = -UM_INF;
      for (uint j = lane; j < pc.len; j += step) { float v = x[base + j]; m = (v > m || isnan(v)) ? v : m; }
      res = subgroupMax(m);
    } else {
      float m = UM_INF;
      for (uint j = lane; j < pc.len; j += step) { float v = x[base + j]; m = (v < m || isnan(v)) ? v : m; }
      res = subgroupMin(m);
    }
    if (lane == 0u) y[row] = res;
  }
}
